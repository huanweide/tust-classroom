/* ═══════════════════════════════════════
   TUST 空闲教室 — 微信小程序样式
   750rpx = 屏幕宽度
   ═══════════════════════════════════════ */

.container { padding: 24rpx; padding-bottom: 60rpx; max-width: 750rpx; margin: 0 auto; }

/* Header */
.header { text-align: center; padding: 20rpx 0 12rpx; }
.header-title { font-size: 40rpx; font-weight: 700; color: #0F172A; letter-spacing: -1rpx; }
.header-sub { font-size: 24rpx; color: #64748B; margin-top: 6rpx; }

/* Section */
.section { margin-bottom: 20rpx; }
.label { font-size: 24rpx; color: #475569; margin-bottom: 10rpx; font-weight: 500; }

.picker {
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #E2E8F0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #0F172A;
}

/* Date Nav */
.date-nav { display: flex; align-items: center; gap: 8rpx; }
.date-arrow {
  flex-shrink: 0;
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  background: #FFFFFF; border: 2rpx solid #E2E8F0; border-radius: 50%;
  font-size: 24rpx; color: #475569;
}
.date-arrow:active { background: #F1F5F9; }
.date-scroll { flex: 1; white-space: nowrap; }
.date-list { display: flex; gap: 10rpx; padding: 4rpx 0; }
.date-chip {
  flex-shrink: 0;
  width: 110rpx; padding: 14rpx 0;
  text-align: center;
  background: #FFFFFF; border: 2rpx solid #E2E8F0; border-radius: 14rpx;
  transition: all 0.15s;
}
.date-chip.active { background: #0891B2; border-color: #0891B2; }
.date-chip.active .date-mmdd,
.date-chip.active .date-wday { color: #FFFFFF; }
.date-mmdd { font-size: 26rpx; font-weight: 600; color: #0F172A; }
.date-wday { font-size: 20rpx; color: #94A3B8; margin-top: 2rpx; }
.date-today {
  text-align: center; margin-top: 10rpx;
  font-size: 24rpx; color: #0891B2; font-weight: 500;
  padding: 8rpx;
}
.date-today:active { opacity: 0.6; }

/* Cards */
.card {
  margin-bottom: 24rpx;
  background: #FFFFFF; border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  overflow: hidden;
}
.card-header {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx 24rpx 0;
}
.mode-badge {
  flex-shrink: 0;
  width: 80rpx; height: 40rpx; line-height: 40rpx;
  text-align: center; font-size: 20rpx; font-weight: 600; color: #FFFFFF;
  border-radius: 8rpx;
}
.mode1 { background: #0891B2; }
.mode2 { background: #7C3AED; }
.mode3 { background: #22C55E; }
.card-title { font-size: 30rpx; font-weight: 600; color: #0F172A; }
.card-body { padding: 20rpx 24rpx 24rpx; }

/* Form */
.row { display: flex; gap: 16rpx; }
.flex-1 { flex: 1; }
.input {
  padding: 20rpx 24rpx;
  background: #FFFFFF; border: 2rpx solid #E2E8F0; border-radius: 12rpx;
  font-size: 28rpx; color: #0F172A; width: 100%; box-sizing: border-box;
}
.input:focus { border-color: #0891B2; }

/* Suggestions dropdown */
.suggestions {
  margin-top: 8rpx;
  background: #FFFFFF; border: 2rpx solid #E2E8F0; border-radius: 12rpx;
  max-height: 320rpx; overflow-y: auto;
}
.sug-item {
  padding: 18rpx 24rpx; font-size: 26rpx; color: #0F172A;
  border-bottom: 1rpx solid #F1F5F9;
}
.sug-item:last-child { border-bottom: none; }
.sug-item:active { background: #ECFEFF; }

/* Button */
.btn {
  margin-top: 20rpx;
  padding: 22rpx 0;
  text-align: center;
  background: #0891B2; color: #FFFFFF;
  font-size: 28rpx; font-weight: 600;
  border-radius: 14rpx;
}
.btn:active { background: #0E7490; }

/* Loading */
.loading-box {
  display: flex; flex-direction: column; align-items: center;
  padding: 60rpx 0;
}
.spinner {
  width: 56rpx; height: 56rpx;
  border: 4rpx solid #E2E8F0; border-top-color: #0891B2;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { margin-top: 20rpx; font-size: 26rpx; color: #64748B; }

/* Results */
.results { margin-bottom: 24rpx; }
.result-summary {
  font-size: 26rpx; color: #475569; padding: 16rpx 0;
  text-align: center;
}
.result-item {
  background: #FFFFFF; border-radius: 16rpx;
  padding: 24rpx; margin-bottom: 16rpx;
  box-shadow: 0 1rpx 8rpx rgba(0,0,0,0.04);
}
.result-name {
  font-size: 32rpx; font-weight: 700; color: #0F172A;
}
.result-detail { font-size: 24rpx; color: #64748B; margin-top: 6rpx; }
.result-periods { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 16rpx; }
.period-tag {
  padding: 6rpx 16rpx;
  font-size: 22rpx; font-weight: 500; border-radius: 6rpx;
}
.period-tag.free { background: #F0FDF4; color: #15803D; }
.period-tag.busy { background: #FEF2F2; color: #DC2626; }

/* Empty */
.empty-box { text-align: center; padding: 60rpx 0; }
.empty-icon { font-size: 72rpx; margin-bottom: 20rpx; }
.empty-title { font-size: 28rpx; color: #64748B; font-weight: 500; }
.empty-hint { font-size: 24rpx; color: #94A3B8; margin-top: 10rpx; }

/* Footer */
.footer { text-align: center; padding: 30rpx 0; }
.footer-text { font-size: 22rpx; color: #94A3B8; line-height: 1.8; }
